#!/usr/bin/env bash
set -euo pipefail

for name in CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID; do
  if [ -z "${!name:-}" ]; then
    echo "Missing $name" >&2
    exit 1
  fi
done

api() {
  curl -sS \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
    "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/$1"
}

summarize() {
  jq -c '
    if .success then
      {status: "ok", resources: (.result | if type == "array" then map(.name // .id // .queue_name) else .name // .id end)}
    else
      {status: "error", errors: [.errors[]? | {code, message}]}
    end
  '
}

printf 'pages: '
api "pages/projects" | summarize
printf 'r2: '
api "r2/buckets" | summarize
printf 'workers: '
api "workers/scripts" | summarize
printf 'queues: '
api "queues" | summarize
